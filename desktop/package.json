{
  "name": "lecteur-pro",
  "version": "1.2.0",
  "description": "Lecteur Pro : lecteur audio, vidéo, photo et TV pour Windows (7, 8, 8.1, 10, 11)",
  "main": "main.js",
  "author": "My World RS",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never && electron-builder --win nsis --ia32 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.myworldrs.lecteurpro",
    "productName": "Lecteur Pro",
    "files": [
      "main.js",
      "preload.js",
      "telechargement.js",
      "television.html",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "artifactName": "Lecteur-Pro-Installation-${arch}.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  }
}
